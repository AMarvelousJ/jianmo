	<!-- Base objects -->
	<xs:complexType name="objectBaseType">
		<xs:annotation>
			<xs:documentation>Base type for all objects.</xs:documentation>
		</xs:annotation>
		<xs:attribute ref="name" />
		<xs:attribute ref="wallpaper" />
		<xs:attribute ref="visible" />
		<xs:attribute ref="width" />
		<xs:attribute ref="height" />
		<xs:attribute ref="left" />
		<xs:attribute ref="top" />
		<xs:attributeGroup ref="referenceObjectProperties" />
	</xs:complexType>
	<xs:complexType name="parameterType">
		<xs:attribute name="name" type="parameterNameType" use="required" />
		<xs:attribute name="value" type="parameterValueType" />
		<xs:attribute name="description" type="xs:string" />
	</xs:complexType>
	<xs:complexType name="parametersType">
		<xs:sequence>
			<xs:element name="parameter" type="parameterType" maxOccurs="1000" />
		</xs:sequence>
	</xs:complexType>
